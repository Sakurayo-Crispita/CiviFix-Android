<?xml version="1.0" ?>
<resources>


    <style name="Base.Theme.Projectcaxfix" parent="Theme.Material3.Light.NoActionBar">


        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="colorSurface">@color/white</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:fontFamily">@font/jakarta_regular</item>
        <item name="fontFamily">@font/jakarta_regular</item>
        <item name="materialButtonStyle">@style/CiviFix.Button</item>
        <item name="chipStyle">@style/CiviFix.Chip</item>
        <item name="bottomNavigationStyle">@style/CiviFix.Navigation</item>
    </style>


    <style name="Theme.Projectcaxfix" parent="Base.Theme.Projectcaxfix"/>


    <style name="CiviFix.Button" parent="Widget.Material3.Button">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconGravity">textStart</item>
    </style>


    <style name="CiviFix.Button.Secondary" parent="CiviFix.Button">
        <item name="backgroundTint">@color/colorSurfaceVariant</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="strokeWidth">0dp</item>
    </style>


    <style name="CiviFix.Input" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/colorSurfaceVariant</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="hintEnabled">false</item>
    </style>


    <style name="CiviFix.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">11sp</item>
        <item name="chipCornerRadius">18dp</item>
    </style>


    <style name="CiviFix.Navigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:layout_height">72dp</item>
        <item name="android:background">@color/white</item>
        <item name="itemIconSize">20dp</item>
        <item name="itemIconTint">@color/nav_text</item>
        <item name="itemTextColor">@color/nav_text</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">1dp</item>
        <item name="itemTextAppearanceActive">@style/CiviFix.NavText</item>
        <item name="itemTextAppearanceInactive">@style/CiviFix.NavText</item>
    </style>


    <style name="CiviFix.NavText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="fontFamily">@font/jakarta_regular</item>
    </style>


    <style name="CiviFix.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>


</resources>
