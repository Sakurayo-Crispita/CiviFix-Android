<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/colorBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="32dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeWidth="0dp" android:id="@+id/cardHeader" android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_figma_brand" android:contentDescription="@null" android:background="@drawable/bg_mint_circle" android:padding="7dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CIVIFIX CAJAMARCA" android:textSize="12sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:fontFamily="@font/jakarta_semibold" android:layout_marginStart="4dp" />
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="144dp" android:layout_marginTop="4dp">
                    <com.google.android.material.imageview.ShapeableImageView android:layout_width="match_parent" android:layout_height="144dp" android:id="@+id/imgHeader" android:src="@drawable/img_cajamarca_plaza" android:scaleType="centerCrop" android:contentDescription="Plaza de Cajamarca, imagen del diseño" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_gravity="bottom" android:padding="12dp" android:background="@drawable/bg_photo_gradient">
                        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_figma_official" android:contentDescription="@null" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Plataforma Vecinal Oficial" android:textSize="11sp" android:textColor="@color/white" android:includeFontPadding="false" android:layout_weight="1" android:layout_marginStart="4dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Barrios Unidos" android:textSize="11sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:background="@drawable/bg_soft" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                    </LinearLayout>
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Juntos mejoramos Cajamarca" android:textSize="24sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:id="@+id/tvHeaderTitle" android:fontFamily="@font/jakarta_bold" android:layout_marginTop="16dp" android:lineSpacingExtra="3dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reporta baches, alumbrado público, limpieza y espacios públicos en tu barrio en segundos." android:textSize="14sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_soft" android:paddingVertical="12dp" android:layout_marginTop="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textSize="18sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:id="@+id/tvWelcomeResolved" android:fontFamily="@font/jakarta_semibold" android:gravity="center" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Arreglos" android:textSize="11sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:gravity="center" android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textSize="18sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:id="@+id/tvWelcomeNeighborhoods" android:fontFamily="@font/jakarta_semibold" android:gravity="center" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Barrios" android:textSize="11sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:gravity="center" android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Local" android:textSize="18sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:id="@+id/tvWelcomeMode" android:fontFamily="@font/jakarta_semibold" android:gravity="center" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Prototipo" android:textSize="11sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:gravity="center" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <Space android:layout_width="match_parent" android:layout_height="24dp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ingresar a tu cuenta" android:textSize="20sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:id="@+id/tvTitle" android:fontFamily="@font/jakarta_semibold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Accede para seguir tus reportes y apoyar propuestas de vecinos." android:textSize="12sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:id="@+id/tvSubtitle" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" />
                <Space android:layout_width="match_parent" android:layout_height="20dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Correo electrónico o DNI" android:textSize="12sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:fontFamily="@font/jakarta_semibold" android:layout_marginBottom="6dp" />
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CiviFix.Input" android:id="@+id/tilEmailOrDni" app:startIconDrawable="@drawable/ic_figma_identity" app:startIconTint="@null">
                    <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/etEmailOrDni" android:paddingHorizontal="12dp" android:paddingVertical="10dp" android:textSize="14sp" android:inputType="textEmailAddress" android:hint="ej. 71829384 o vecino@cajamarca.pe" android:gravity="center_vertical" />
                </com.google.android.material.textfield.TextInputLayout>
                <Space android:layout_width="match_parent" android:layout_height="16dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Contraseña" android:textSize="12sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:fontFamily="@font/jakarta_semibold" android:layout_marginBottom="6dp" android:layout_weight="1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="¿Olvidaste tu contraseña?" android:textSize="11sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:id="@+id/tvForgotPassword" android:fontFamily="@font/jakarta_semibold" android:paddingVertical="8dp" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CiviFix.Input" android:id="@+id/tilPassword" app:startIconDrawable="@drawable/ic_figma_lock" app:startIconTint="@null" app:endIconMode="password_toggle" app:endIconDrawable="@drawable/ic_figma_eye" app:endIconTint="@null">
                    <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/etPassword" android:paddingHorizontal="12dp" android:paddingVertical="10dp" android:textSize="14sp" android:inputType="textPassword" android:hint="••••••••" android:gravity="center_vertical" android:maxLength="128" />
                </com.google.android.material.textfield.TextInputLayout>
                <Space android:layout_width="match_parent" android:layout_height="20dp" />
                <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnLogin" style="@style/CiviFix.Button" android:text="Iniciar Sesión" app:icon="@drawable/ic_figma_login" app:iconTint="@null" app:iconSize="16dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginVertical="24dp">
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/colorSurfaceVariant" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="o ingresa con" android:textSize="12sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:id="@+id/tvDividerText" android:paddingHorizontal="12dp" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/colorSurfaceVariant" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnDniKey" style="@style/CiviFix.Button.Secondary" android:text="DNI Electrónico / Clave Perú" app:icon="@drawable/ic_figma_fingerprint" app:iconTint="@null" app:iconSize="16dp" />
                <Space android:layout_width="match_parent" android:layout_height="8dp" />
                <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnGoogle" style="@style/CiviFix.Button.Secondary" android:text="Continuar con Google" app:icon="@drawable/ic_figma_google" app:iconTint="@null" app:iconSize="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/llRegisterContainer" android:background="@drawable/bg_soft" android:padding="16dp" android:layout_marginTop="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="¿No tienes una cuenta aún?" android:textSize="14sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:id="@+id/tvNoAccountPrompt" android:gravity="center" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Regístrate como vecino de Cajamarca →" android:textSize="14sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:id="@+id/tvRegisterAction" android:fontFamily="@font/jakarta_semibold" android:gravity="center" android:layout_marginTop="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_figma_shield" android:contentDescription="@null" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Iniciativa ciudadana y Municipalidad Provincial de Cajamarca" android:textSize="11sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:gravity="center" android:layout_marginStart="8dp" />
        </LinearLayout>
        <TextView android:id="@+id/tvCredits" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Créditos de imágenes" android:textSize="11sp" android:textColor="@color/colorPrimary" android:gravity="center" android:paddingTop="16dp" />
    </LinearLayout>
</ScrollView>
