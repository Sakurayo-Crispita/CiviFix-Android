<?xml version="1.0" ?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:id="@+id/ivAuthorAvatar" android:src="@drawable/ic_figma_user" android:background="@drawable/bg_mint_circle" android:padding="12dp" android:contentDescription="Vecino que reportó"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vecino" android:textSize="12sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:id="@+id/tvAuthorName" android:fontFamily="@font/jakarta_semibold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Barrio · Hace un momento" android:textSize="10sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:id="@+id/tvNeighborhoodAndTime" android:layout_marginTop="3dp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reportado" android:textSize="10sp" android:textColor="@color/colorOrange" android:includeFontPadding="false" android:id="@+id/tvStatusBadge" android:fontFamily="@font/jakarta_semibold" android:background="@drawable/bg_status_chip" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:layout_gravity="top"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Título del reporte" android:textSize="16sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:id="@+id/tvReportTitle" android:fontFamily="@font/jakarta_semibold" android:layout_marginTop="16dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Descripción del reporte" android:textSize="14sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:id="@+id/tvReportDescription" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp"/>
        <com.google.android.material.imageview.ShapeableImageView android:layout_width="match_parent" android:layout_height="192dp" android:id="@+id/ivReportImage" android:layout_marginTop="16dp" android:scaleType="centerCrop" android:contentDescription="Evidencia fotográfica del reporte" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reportado     En cuadrilla     Reparación     Listo" android:textSize="10sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:id="@+id/tvProgressLabels" android:background="@drawable/bg_soft" android:padding="8dp" android:layout_marginTop="16dp"/>
        <com.google.android.material.progressindicator.LinearProgressIndicator android:layout_width="match_parent" android:layout_height="4dp" android:id="@+id/reportProgress" android:layout_marginHorizontal="8dp" android:progress="25" app:indicatorColor="@color/colorPrimary" app:trackColor="@color/colorSurfaceVariant"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="0 apoyos comunitarios" android:textSize="11sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:id="@+id/tvSupportCount" android:fontFamily="@font/jakarta_semibold" android:layout_weight="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 comentarios" android:textSize="11sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:id="@+id/tvCommentCount"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
            <com.google.android.material.button.MaterialButton android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/btnSupport" style="@style/CiviFix.Button.Secondary" android:text="Apoyar" android:layout_weight="1" android:textSize="12sp"/>
            <com.google.android.material.button.MaterialButton android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/btnComment" style="@style/CiviFix.Button.Secondary" android:text="Comentar" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:textSize="12sp"/>
            <com.google.android.material.button.MaterialButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnShare" style="@style/CiviFix.Button.Secondary" app:icon="@drawable/ic_figma_share" app:iconTint="@null" app:iconGravity="textStart" android:contentDescription="Compartir reporte"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnNewReport" style="@style/CiviFix.Button" android:text="Reportar nueva incidencia →" app:icon="@drawable/ic_figma_official" app:iconTint="@null" app:iconSize="16dp" android:layout_marginTop="8dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
