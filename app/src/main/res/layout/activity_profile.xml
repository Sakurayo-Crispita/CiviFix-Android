<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/colorBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CiviFix Cajamarca" android:textSize="14sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:fontFamily="@font/jakarta_semibold" android:gravity="end"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cajamarca Centro" android:textSize="11sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:id="@+id/tvLocationName" android:gravity="end" android:layout_marginTop="3dp"/>
        </LinearLayout>
        <com.google.android.material.imageview.ShapeableImageView android:layout_width="32dp" android:layout_height="32dp" android:id="@+id/ivUserProfile" android:layout_marginStart="16dp" android:background="@drawable/bg_mint_circle" android:padding="8dp" android:src="@drawable/ic_figma_user" android:contentDescription="Abrir mi perfil" app:shapeAppearanceOverlay="@style/CiviFix.Circle"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="32dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeWidth="0dp" android:layout_marginTop="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="96dp" android:layout_height="96dp" android:id="@+id/imgProfile" android:layout_gravity="center" android:src="@drawable/ic_figma_user" android:background="@drawable/bg_mint_circle" android:padding="28dp" android:contentDescription="Cambiar foto de perfil" app:shapeAppearanceOverlay="@style/CiviFix.Circle"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cambiar foto" android:textSize="11sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:id="@+id/tvChangePhoto" android:gravity="center" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vecino Activo de Cajamarca" android:textSize="12sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:id="@+id/tvTitle" android:fontFamily="@font/jakarta_semibold" android:gravity="center" android:background="@drawable/bg_soft" android:padding="4dp" android:layout_marginTop="12dp"/>
                        <androidx.compose.ui.platform.ComposeView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/composeSummary" android:layout_marginTop="16dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <Space android:layout_width="match_parent" android:layout_height="24dp"/>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_figma_citizen" android:contentDescription="@null"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Datos del Ciudadano" android:textSize="16sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:fontFamily="@font/jakarta_semibold" android:layout_weight="1" android:layout_marginStart="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Editable" android:textSize="10sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false"/>
                    </LinearLayout>
                    <Space android:layout_width="match_parent" android:layout_height="16dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre y Apellidos" android:textSize="12sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:fontFamily="@font/jakarta_semibold" android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CiviFix.Input">
                        <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/etName" android:paddingHorizontal="12dp" android:paddingVertical="10dp" android:textSize="14sp" android:inputType="textPersonName" android:hint="" android:gravity="center_vertical" android:maxLength="80"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <Space android:layout_width="match_parent" android:layout_height="16dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Barrio o Sector Comunitario" android:textSize="12sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:fontFamily="@font/jakarta_semibold" android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CiviFix.Input">
                        <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/etNeighborhood" android:paddingHorizontal="12dp" android:paddingVertical="10dp" android:textSize="14sp" android:inputType="textCapWords" android:hint="" android:gravity="center_vertical" android:maxLength="100"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="San Sebastián" android:textSize="10sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:background="@drawable/bg_soft" android:padding="6dp" android:layout_marginEnd="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chontapaccha" android:textSize="10sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:background="@drawable/bg_soft" android:padding="6dp" android:layout_marginEnd="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cumbemayo" android:textSize="10sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:background="@drawable/bg_soft" android:padding="6dp" android:layout_marginEnd="4dp"/>
                    </LinearLayout>
                    <Space android:layout_width="match_parent" android:layout_height="16dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Correo Electrónico y DNI" android:textSize="12sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:fontFamily="@font/jakarta_semibold" android:layout_marginBottom="6dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cargando cuenta…" android:textSize="14sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:id="@+id/tvIdentity" android:background="@drawable/bg_soft" android:padding="12dp"/>
                    <Space android:layout_width="match_parent" android:layout_height="16dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Teléfono / WhatsApp de Alertas" android:textSize="12sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:fontFamily="@font/jakarta_semibold" android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/CiviFix.Input">
                        <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/etPhone" android:paddingHorizontal="12dp" android:paddingVertical="10dp" android:textSize="14sp" android:inputType="phone" android:hint="+51 976 234 567" android:gravity="center_vertical" android:maxLength="24"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Número de contacto guardado en este dispositivo." android:textSize="11sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <Space android:layout_width="match_parent" android:layout_height="24dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_figma_reports" android:contentDescription="@null"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Mis Reportes Recientes" android:textSize="16sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:fontFamily="@font/jakarta_semibold" android:layout_weight="1" android:layout_marginStart="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ver todos ›" android:textSize="11sp" android:textColor="@color/colorPrimary" android:includeFontPadding="false" android:id="@+id/tvAllReports" android:fontFamily="@font/jakarta_semibold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/recentReports" android:orientation="vertical" android:layout_marginTop="12dp"/>
            <Space android:layout_width="match_parent" android:layout_height="24dp"/>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_figma_alerts" android:contentDescription="@null"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Preferencias de Alertas Comunitarias" android:textSize="14sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:fontFamily="@font/jakarta_semibold" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <Space android:layout_width="match_parent" android:layout_height="16dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Notificaciones de avances en mi barrio" android:textSize="12sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:fontFamily="@font/jakarta_semibold"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Entérate cuando se resuelvan incidencias cercanas" android:textSize="11sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch android:layout_width="wrap_content" android:layout_height="48dp" android:id="@+id/switchProgress"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Alertas vecinales urgentes" android:textSize="12sp" android:textColor="@color/colorTextPrimary" android:includeFontPadding="false" android:fontFamily="@font/jakarta_semibold"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cortes de servicio de agua o desvíos viales" android:textSize="11sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch android:layout_width="wrap_content" android:layout_height="48dp" android:id="@+id/switchUrgent"/>
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Preferencias locales. El envío de alertas aún no está conectado." android:textSize="10sp" android:textColor="@color/colorTextSecondary" android:includeFontPadding="false"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <Space android:layout_width="match_parent" android:layout_height="24dp"/>
            <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnSaveProfile" style="@style/CiviFix.Button" android:text="Guardar Cambios" app:icon="@drawable/ic_figma_save" app:iconTint="@null" app:iconSize="16dp"/>
            <Space android:layout_width="match_parent" android:layout_height="8dp"/>
            <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnLogout" style="@style/CiviFix.Button.Secondary" android:text="Cerrar Sesión" app:icon="@drawable/ic_figma_logout" app:iconTint="@null" app:iconSize="16dp" android:textColor="#C62828"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="72dp" android:background="@color/white">
        <com.google.android.material.bottomnavigation.BottomNavigationView android:layout_width="0dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:layout_height="wrap_content" android:id="@+id/bottomNavigation" style="@style/CiviFix.Navigation" app:menu="@menu/bottom_nav_menu"/>
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:layout_width="56dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintHorizontal_bias="0.375" android:layout_height="56dp" android:id="@+id/fabNewReport" android:src="@drawable/ic_figma_plus" android:contentDescription="Crear nuevo reporte" app:backgroundTint="@color/colorPrimary" app:tint="@null" app:shapeAppearanceOverlay="@style/CiviFix.Circle" app:maxImageSize="20dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
